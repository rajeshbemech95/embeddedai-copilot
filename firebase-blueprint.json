{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data stored under their authentication UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User authentication UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Display name of the user" },
        "photoURL": { "type": "string", "description": "User avatar URL" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["uid", "email"]
    },
    "Project": {
      "title": "Project",
      "description": "Embedded engineering project metadata owned by a specific user.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "description": "Unique project identifier" },
        "ownerUID": { "type": "string", "description": "Owner authentication UID" },
        "projectName": { "type": "string", "description": "Name of the embedded project" },
        "description": { "type": "string", "description": "Detailed description of the firmware/hardware setup" },
        "technology": { "type": "string", "description": "Core technology (e.g. ESP32, FreeRTOS, Embedded Linux)" },
        "targetChip": { "type": "string", "description": "Microcontroller or processor family" },
        "createdAt": { "type": "string", "description": "ISO timestamp of project creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["projectId", "ownerUID", "projectName", "technology"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A conversation thread between the embedded engineer and EmbeddedAI Copilot.",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string", "description": "Unique conversation ID" },
        "userId": { "type": "string", "description": "Authenticated user UID" },
        "title": { "type": "string", "description": "Conversation title or topic" },
        "projectId": { "type": "string", "description": "Associated project ID if any" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" },
        "lastMessage": { "type": "string", "description": "Snippet of the most recent message" }
      },
      "required": ["conversationId", "userId", "title"]
    },
    "Message": {
      "title": "Message",
      "description": "An individual chat message within a conversation thread.",
      "type": "object",
      "properties": {
        "messageId": { "type": "string", "description": "Unique message identifier" },
        "conversationId": { "type": "string", "description": "Parent conversation ID" },
        "userId": { "type": "string", "description": "Authenticated user UID" },
        "role": { "type": "string", "description": "Message sender role", "enum": ["user", "assistant", "system"] },
        "content": { "type": "string", "description": "Markdown formatted message content or code" },
        "timestamp": { "type": "string", "description": "ISO timestamp of message dispatch" }
      },
      "required": ["messageId", "conversationId", "userId", "role", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user account profile, accessible solely by the matching authenticated user."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "User embedded projects with firmware and hardware specifications."
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "User chat threads with EmbeddedAI Copilot."
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual messages belonging to a conversation."
    }
  }
}
